{
  "name": "pocket-watcher",
  "version": "0.1.0-hackathon.1",
  "description": "Make your coding agent finish before your compute budget does. Budget-aware execution governor for Bob and coding agents.",
  "type": "module",
  "bin": {
    "pocket": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=src/__tests__",
    "dev": "tsc --watch",
    "pack:verify": "npm pack --dry-run"
  },
  "keywords": [
    "pocket-watcher",
    "budget",
    "compute",
    "coding-agent",
    "bob",
    "bobcoin",
    "ai-agent",
    "cost-control",
    "scope-management"
  ],
  "license": "MIT",
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
